@model TModel

@{
    Layout = null;
}
@model Movies

<h2>Confirm Deletion</h2>
<h3>@Model.MovieTitle</h3>
<form method="post">
    <input type="hidden" asp-for="MovieId" />
    
    <button type="submit">Delete</button>
    <a class="btn btn-info" asp-controller="Home" asp-action="AllMovies">Cancel</a>
</form>