
@{

}
@model List<Movie>  

<table class="table table-bordered">
    <thead class="fw-bold">
    <tr>
        <td>Movie Title</td>
        <td>Category</td>
        <td>Release Year</td>
        <td>Director</td>
        <td>Rating</td>
        <td>Edited</td>
        <td>Lent To</td>
        <td>Copied To Plex</td>
        <td>Notes</td>
        <td>Actions</td>
    </tr>
    </thead>

    <tbody>
    @foreach (var x in Model)  
    {
        <tr>
            <!-- Display movie details -->
            <td>@x.Title</td>
                
            <!-- Ensure category exists before displaying -->
            <td>
                @if (x.Categories != null)  
                {
                    @x.Categories.CategoryName  
                }
            </td>

            <td>@x.Year</td>
            <td>@x.Director</td>
            <td>@x.Rating</td>

            <!-- Convert numeric values to Yes/No format -->
            <td>@(x.Edited == 1 ? "Yes" : "No")</td>
            <td>@x.LentTo</td>
            <td>@(x.CopiedToPlex == 1 ? "Yes" : "No")</td>
            <td>@x.Notes</td>

            <!-- Edit and Delete action buttons -->
            <td><a class="btn btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a></td>
            <td><a class="btn btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId">Delete</a></td>
        </tr>
    }
    </tbody>
</table>
