
@{
    Layout = null;
}
@model List<Form>
<table class="table table-bordered">
    <thead class="fw-bold">
    <tr>
        <td>Movie Title</td>
        <td>CategoryName</td>
        <td>Release Year</td>
        <td>Director</td>
        <td>Rating</td>
        <td>Edited</td>
        <td>Lent To</td>
        <td>Copied To Plex</td>
        <td>Notes</td>
    </tr>
    
    </thead>
    
    @foreach (var x in Model)
    {
        <tbody>
        <tr>
            <td>@x.MovieTitle</td>
            <td>@x.CategoryName</td>
            <td>@x.ReleaseYear</td>
            <td>@x.Director</td>
            <td>@x.Rating</td>
            <td>@x.Edited</td>
            <td>@x.LentTo</td>
            <td>@x.CopiedToPlex</td>
            <td>@x.Notes</td>
        </tr>
        
        </tbody>
    }
    
</table>