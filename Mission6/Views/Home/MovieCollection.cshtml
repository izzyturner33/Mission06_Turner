@model Mission6.Models.Form
<!--form to submit a movie collection-->
<h1>Movie Collection Form</h1>

<form method="post">
    <label asp-for="MovieTitle">Movie Title:</label>
    <input asp-for="MovieTitle"/>
    <br/>
    <label asp-for="CategoryName">CategoryName:</label>
    <select asp-for="CategoryName">
        <option value="Action">Action</option>
        <option value="Comedy">Comedy</option>
        <option value="Drama">Drama</option>
        <option value="Romance">Romance</option>
    </select>
    <br/>
    <label asp-for="ReleaseYear">Release Year:</label>
    <input asp-for="ReleaseYear"/>
    <br/>
    <label asp-for="Director">Director:</label>
    <input asp-for="Director"/>
    <br/>
    <label asp-for="Rating">Rating</label>
    <select asp-for="Rating">
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <br/>
    <label asp-for="Edited">Is this film edited?</label>
    <select asp-for="Edited">
        <option value="Null"> </option>
        <option value="Yes">Yes</option>
        <option value="No">No</option>
    </select>
    <br/>
    <label asp-for="LentTo">Lent To:</label>
    <input asp-for="LentTo"/>
    <br/>
    <label asp-for="CopiedToPlex">Copied To Plex:</label>
    <input asp-for="CopiedToPlex"/>
    <br/>
    <label asp-for="Notes">Notes:</label>
    <input asp-for="Notes"/>
    <br/>

    <button type="submit">Submit Movie</button>

</form>

